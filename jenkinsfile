pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Code checked out from GitHub'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Python application'
                sh 'python --version'
            }
        }

        stage('Test') {
            steps {
                echo 'Running application tests'
                sh 'python -m unittest'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment stage completed'
            }
        }
    }
}
